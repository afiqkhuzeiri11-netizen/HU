-- Fungsi Pembuat Tombol Aman dari Error
local function createStyledButton(name, callback)
    local Btn = Instance.new("TextButton")
    Btn.Parent = Container
    Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    Btn.BackgroundTransparency = 0.35
    Btn.Size = UDim2.new(1, 0, 0, 40)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.Text = name
    Btn.TextColor3 = Color3.fromRGB(240, 240, 250)
    Btn.TextSize = 13
    
    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 10)
    BtnCorner.Parent = Btn
    
    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Parent = Btn
    BtnStroke.Color = Color3.fromRGB(255, 105, 180)
    BtnStroke.Transparency = 0.5
    BtnStroke.Thickness = 1
    
    Btn.MouseButton1Click:Connect(function()
        pcall(function()
            local tween = TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(255, 105, 180)})
            tween:Play()
        end)
        task.wait(0.1)
        pcall(function()
            local tweenBack = TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(30, 30, 45)})
            tweenBack:Play()
        end)
        
        -- Bungkus callback dengan pcall agar script utama tidak crash jika terjadi error mendadak
        local success, err = pcall(callback)
        if not success then
            warn("Aksi tombol gagal: ", err)
        end
    end)
end


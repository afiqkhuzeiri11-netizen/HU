-- Fungsi Anti-Guard Kuat: Melumpuhkan SEMUA NPC/Model bergerak yang bukan Player di Workspace
local function bypassGuards()
    pcall(function()
        local myChar = localPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj and obj:IsA("Model") and obj ~= myChar then
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                
                -- Cek apakah objek ini adalah NPC (Memiliki Humanoid tapi bukan bagian dari Players)
                if humanoid and rootPart and rootPart:IsA("BasePart") then
                    local isPlayer = false
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character == obj then
                            isPlayer = true
                            break
                        end
                    end
                    
                    -- Jika bukan player, berarti NPC / Guard / Musuh -> Lumpuhkan total!
                    if not isPlayer then
                        pcall(function()
                            humanoid.WalkSpeed = 0
                            humanoid.JumpPower = 0
                            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                            -- Hapus target atau buang jauh ke bawah agar tidak bisa mendeteksi player
                            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, -2000, 0)
                        end)
                    end
                end
            end
        end
    end)
end

-- Fitur 1: Curi Telur + Bawa Telur & Teleport Sempurna ke Plot
createStyledButton("🥚 Curi Telur & Auto Teleport Plot", function()
    bypassGuards()
    local character = localPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = character.HumanoidRootPart
    
    local closestEgg = nil
    local shortestDistance = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj and obj.Name and obj.Name:lower():find("egg") and (obj:IsA("BasePart") or obj:IsA("Model")) then
            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
            if part and part:IsA("BasePart") then
                local distance = (rootPart.Position - part.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestEgg = obj
                end
            end
        end
    end

    if closestEgg then
        local eggPart = closestEgg:IsA("Model") and (closestEgg.PrimaryPart or closestEgg:FindFirstChildWhichIsA("BasePart")) or closestEgg
        if eggPart and eggPart:IsA("BasePart") then
            rootPart.CFrame = eggPart.CFrame + Vector3.new(0, 2, 0)
            task.wait(0.15)
            
            local prompt = closestEgg:FindFirstChildWhichIsA("ProximityPrompt", true)
            local clickDetector = closestEgg:FindFirstChildWhichIsA("ClickDetector", true)
            if prompt then 
                pcall(function() fireproximityprompt(prompt) end)
            elseif clickDetector then 
                pcall(function() fireclickdetector(clickDetector) end)
            end
            
            task.wait(0.15)
            
            if closestEgg:IsA("Model") then
                pcall(function() closestEgg:MoveTo(plotPosition + Vector3.new(0, 3, 0)) end)
            else
                pcall(function() closestEgg.CFrame = CFrame.new(plotPosition + Vector3.new(0, 3, 0)) end)
            end
            
            rootPart.CFrame = CFrame.new(plotPosition + Vector3.new(0, 4, 0))
        end
    end
end)

